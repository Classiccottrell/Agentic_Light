{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agentic Light VPAT / ACR draft report",
  "type": "object",
  "required": ["schema_version", "product", "report", "evaluation_methods", "criteria", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "product": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string" } }
    },
    "report": {
      "type": "object",
      "required": ["title", "version", "date"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "contact": { "type": "string" }
      }
    },
    "evaluation_methods": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "level", "rating", "remarks"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "level": { "type": "string", "enum": ["A", "AA", "AAA"] },
          "rating": { "type": "string", "enum": ["Supports", "Partially Supports", "Does Not Support", "Not Applicable"] },
          "remarks": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "enum": ["automated", "manual", "both"] }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
