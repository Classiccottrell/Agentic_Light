# System_Config/.notify.env.example
#
# Copy this file to System_Config/.notify.env and chmod 600 it.
# NEVER commit .notify.env — it holds webhook URLs (git-ignored already).
#
# Google Chat: target space → Apps → Webhooks → Manage webhooks → Add
GCHAT_WEBHOOK_URL=""
# Slack: api.slack.com/apps → your app → Incoming Webhooks → Add New Webhook to Workspace
SLACK_WEBHOOK_URL=""
# 1 = also try a local macOS banner via osascript (no-op if osascript isn't present)
GCHAT_FALLBACK_LOCAL=0
