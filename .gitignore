# Local MCP config — copy from System_Config/mcp.defaults.json, never commit
.mcp.json
.agentic-light.conf

# Local notification webhook config — copy from System_Config/.notify.env.example, never commit
System_Config/.notify.env

# Obsidian per-machine session state (vault config itself is shipped, see CLAUDE.md)
.obsidian/workspace*.json
.obsidian/workspace-mobile.json

# Runtime logs
System_Config/logs/*.log
System_Config/logs/*.out
System_Config/logs/*.err
pipeline/logs/*.log

# OS cruft
.DS_Store

# Semantic/search caches (rebuildable — Markdown remains the source of truth)
brain/wiki/.memoryfield.sqlite3*
brain/index/

# Private session source manifests and generated context records
System_Config/context-sources.local.json
System_Config/context-manifest.local.json
System_Config/context-manifest.local.json.context-discover
brain/context/
brain/raw/.ingested.log

# Shared brain write lock (System_Config/brain_lock.py): lock dir (+ reclaim mutex / stale copies), spooled session entries, per-hour notice markers
System_Config/logs/brain.lock.d*
System_Config/logs/log_session.pending*
System_Config/logs/.log_session.pending*
System_Config/logs/.brain-lock-notified-*
